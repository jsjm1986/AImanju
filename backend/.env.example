# ==================== 服务器配置 ====================
PORT=8333
HOST=0.0.0.0
NODE_ENV=development

# ==================== 数据库配置 ====================
MONGODB_URI=mongodb://localhost:27017/comic-script

# ==================== JWT 鉴权 ====================
# 生成强密钥（生产必须修改）：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=please-change-to-strong-random-secret-in-production
JWT_CREATOR_SECRET=
JWT_AGENT_SECRET=

# ==================== CORS 配置 ====================
# 多个源用逗号分隔，留空则允许所有
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8884

# ==================== 默认 AI 模型 ====================
# 可选值：claude / openai / glm / dashscope
DEFAULT_AI_PROVIDER=claude

# ==================== Anthropic Claude ====================
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_API_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-5-20250929
CLAUDE_THINKING_ENABLED=false
CLAUDE_THINKING_BUDGET=10000
# 多密钥轮换（可选）
CLAUDE_API_KEY_2=
CLAUDE_API_KEY_3=

# ==================== OpenAI 兼容（自定义网关） ====================
OPENAI_API_KEY=your-openai-compatible-key
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ==================== 智谱 GLM ====================
GLM_API_KEY=your-glm-api-key
GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.5

# 智谱夜间通道（可选，独立配额）
GLM_NIGHT_API_KEY=
GLM_NIGHT_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_NIGHT_MODEL=glm-4.5

# ==================== 火山方舟 (豆包) ====================
ARK_API_KEY=your-ark-api-key
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-pro

# ==================== DeepSeek ====================
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ==================== 阿里云百炼 (DashScope) ====================
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== 自定义模型网关（可选） ====================
# 如使用统一网关代理多家模型，配置以下变量
CUSTOM_GATEWAY_API_KEY=your-gateway-api-key
CUSTOM_GATEWAY_BASE_URL=https://your-gateway-url/v1

# ==================== 速率限制 ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_WINDOW_MS=3600000
AI_RATE_LIMIT_MAX=20

# ==================== 管理员账户初始化（可选） ====================
# 仅供初始化迁移脚本使用，部署后请通过界面修改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-this-default-password
ADMIN_EMAIL=admin@example.com
